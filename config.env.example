# 复制本文件为 config.env，然后填入你自己的信息（本地运行用）
# 注意：config.env 如果是真实账号密码，请务必不要提交到公开仓库；本仓库是私有仓库。
USERNAME=你的论坛账号
PASSWORD=你的论坛登录密码
SMTP_HOST=smtp.qq.com
MAIL_USER=你的发件邮箱@qq.com
MAIL_PASS=授权码
# 收件邮箱，留空则默认发给发件人自己
MAIL_TO=
# 方案A 才需要代理（云端跑 GitHub Actions 时用）；本地跑可留空
# PROXY_URL=http://用户:密码@主机:端口
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
